# Copy this file to `.env` (same folder as compose.yml) and fill in real values.
# `.env` is gitignored on purpose — never commit real credentials here.
# Get the shared team login for this from wherever the team keeps secrets
# (password manager / private DM), not from this repo.

GARMINCONNECT_EMAIL=your_garminconnect_email
# Must be Base64 encoded, not plaintext. Encode with:
#   echo -n 'the_real_password' | base64
GARMINCONNECT_BASE64_PASSWORD=your_base64_encoded_garminconnect_password
