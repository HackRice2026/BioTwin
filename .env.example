DATABASE_URL=sqlite:///./data/biotwin.db
PUBLIC_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
# Optional. Lets a teammate on the same WiFi reach this machine's dev
# servers over its LAN IP instead of localhost, e.g. http://192.168.1.23:5173
# -- exactly the URL they'll open in their browser. Additive to
# FRONTEND_ORIGIN/PUBLIC_URL above; leave empty to keep LAN access closed.
# See README "LAN access" for how to find your IP. Restart the backend
# after changing this.
LAN_ORIGIN=
DEMO_ENABLED=true
# Opt-in. false (default): the unauthenticated fallback account is the
# project's normal synthetic demo. true: it's instead continuously
# live-synced from a local garmin viz dashboard InfluxDB, real data with
# zero login -- fine on 127.0.0.1, reconsider before exposing beyond it.
DEMO_USES_REAL_DATA=false
RETENTION_DAYS=90
COOKIE_SECURE=false
# Generate with: .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
# TODO(blocked): supply OAuth client credentials and configure redirect URLs; see docs/INTEGRATIONS.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_NUMBER=
GOOGLE_WEBHOOK_SECRET=
# TODO(blocked): supply Azure app registration credentials; see docs/INTEGRATIONS.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_WEBHOOK_SECRET=
# Gemini receives only the question and the computed NarrationContext when enabled.
NARRATION_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
NARRATION_API_KEY=
NARRATION_MODEL=gemini-3.1-flash-lite
ALLOW_EXTERNAL_NARRATION=false
# Alternate narration backend: Vertex AI instead of the AI Studio key above.
# Bills through the project's normal Cloud Billing account rather than an AI
# Studio key's separate prepay balance -- try this if that balance is
# depleted. Needs `gcloud auth application-default login` run once on
# whichever machine runs the server (see AGENTS.md, "Vertex AI narration
# setup"); still needs ALLOW_EXTERNAL_NARRATION=true above.
USE_VERTEX_NARRATION=false
VERTEX_PROJECT_ID=
VERTEX_REGION=us-central1
VERTEX_MODEL=gemini-2.5-flash

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
